# ---------------------------------------------------------------------------
# Selecao do provider ativo. Pode ser trocado por tenant via TenantStore,
# isto aqui e apenas o default global usado pela config helper / exemplos.
# valores possiveis: "meta" | "azure"
# ---------------------------------------------------------------------------
WHATSAPP_DEFAULT_PROVIDER=meta

# ---------------------------------------------------------------------------
# Meta Cloud API (WhatsApp Business Platform direto na Meta)
# ---------------------------------------------------------------------------
# Versao da Graph API usada nas chamadas
META_GRAPH_API_VERSION=v21.0
# Token de acesso do system user / app (por tenant, ver tenancy/TenantStore)
META_ACCESS_TOKEN=
# ID do numero de telefone (phone_number_id) no WhatsApp Manager
META_PHONE_NUMBER_ID=
# App secret do app da Meta, usado para validar a assinatura HMAC dos webhooks
META_APP_SECRET=
# Verify token arbitrario definido por voce na configuracao do webhook
META_WEBHOOK_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# Azure Communication Services - Advanced Messaging for WhatsApp
# ---------------------------------------------------------------------------
# Connection string do recurso Azure Communication Services
AZURE_ACS_CONNECTION_STRING=
# ID do Channel Registration (canal WhatsApp conectado no ACS)
AZURE_CHANNEL_REGISTRATION_ID=
