{
  "name": "@paulorogge/whatsapp-gateway",
  "version": "0.1.0",
  "description": "Modulo plugavel de integracao com o WhatsApp Business Platform (Meta Cloud API) com suporte opcional a Azure Communication Services (Advanced Messaging), multi-tenant, sem dependencia de framework HTTP.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-business-api",
    "meta-cloud-api",
    "azure-communication-services",
    "multi-tenant"
  ],
  "author": "Paulo Rogge de Castro <paulorogge@paulorogge.com.br>",
  "dependencies": {
    "@azure-rest/communication-messages": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
